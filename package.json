{
  "name": "hashi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/fonts.mjs",
    "dev": "node scripts/dev.mjs",
    "clean": "node scripts/clean.mjs",
    "fonts": "node scripts/fonts.mjs",
    "og-fonts": "node scripts/og-fonts.mjs",
    "coverage": "node scripts/coverage.mjs",
    "bundle-size": "node scripts/bundle-size.mjs",
    "perf:hydration": "playwright test -c e2e/perf.config.ts",
    "css": "tailwindcss -i style/tailwind.css -o target/site/pkg/hashi.css",
    "css:watch": "tailwindcss -i style/tailwind.css -o target/site/pkg/hashi.css --watch",
    "e2e": "playwright test -c e2e",
    "e2e:container": "node scripts/e2e-container.mjs",
    "e2e:update-snapshots": "node scripts/e2e-container.mjs --project visual --update-snapshots",
    "app:web": "cd app && trunk serve --dist ../target/app-dev",
    "app:build": "cd app && trunk build --release",
    "app:e2e": "playwright test -c e2e/app.config.ts",
    "app:android-e2e": "playwright test -c e2e/android.config.ts",
    "smoke:production": "playwright test -c e2e/production.config.ts"
  },
  "devDependencies": {
    "@fontsource-variable/murecho": "^5.3.1",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-sans-tc": "^5.3.1",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/dotgothic16": "^5.3.1",
    "@fontsource/kaisei-decol": "^5.3.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/cli": "^4.3.3",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  }
}
