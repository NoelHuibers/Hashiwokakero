diff --git a/minisat/core/Solver.h b/minisat/core/Solver.h
index 09367f9..729c226 100644
--- a/minisat/core/Solver.h
+++ b/minisat/core/Solver.h
@@ -75,6 +75,20 @@ public:
     TrailIterator  trailBegin()   const;
     TrailIterator  trailEnd  ()   const;
 
+    // DRAT proof: learnt, strengthened and deleted clauses are written to 'drat' in the binary
+    // format when it is set.
+    FILE*   drat;
+    template<class Lits> void dratAdd   (const Lits& c) { dratWrite('a', c); }
+    template<class Lits> void dratDelete(const Lits& c) { dratWrite('d', c); }
+    template<class Lits> void dratWrite (int kind, const Lits& c) {
+        if (drat == NULL) return;
+        putc(kind, drat);
+        for (int i = 0; i < c.size(); i++){
+            unsigned u = 2 * (var(c[i]) + 1) + sign(c[i]);
+            for (; u > 127; u >>= 7) putc(128 | (u & 127), drat);
+            putc(u, drat); }
+        putc(0, drat); }
+
     void    toDimacs     (FILE* f, const vec<Lit>& assumps);            // Write CNF to file in DIMACS-format.
     void    toDimacs     (const char *file, const vec<Lit>& assumps);
     void    toDimacs     (FILE* f, Clause& c, vec<Var>& map, Var& max);
