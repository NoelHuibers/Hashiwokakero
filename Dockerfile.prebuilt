# The image the CI deploys: the binary and site built by its "Build site" jobs, unpacked to dist/
# (see .github/workflows/ci.yml). The same runtime as the last stage of Dockerfile, which builds
# everything itself; keep the two in sync.
FROM debian:trixie-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# The server binary, the hashes of the JS/WASM/CSS file names (read next to the binary) and the
# site (JS/WASM/CSS and public assets)
COPY dist/hashi dist/hash.txt /app/
COPY dist/site /app/site

ENV RUST_LOG="info"
ENV LEPTOS_OUTPUT_NAME="hashi"
ENV LEPTOS_SITE_ADDR="0.0.0.0:8080"
ENV LEPTOS_SITE_ROOT="site"
ENV LEPTOS_SITE_PKG_DIR="pkg"
ENV LEPTOS_HASH_FILES="true"
ENV LEPTOS_ENV="PROD"
EXPOSE 8080

CMD ["/app/hashi"]
