{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hashi",
  "version": "0.0.1",
  "identifier": "rs.hashi",
  "build": {
    "frontendDist": "../../target/app-dist",
    "devUrl": "http://127.0.0.1:8080",
    "beforeDevCommand": "pnpm run app:web",
    "beforeBuildCommand": "pnpm run app:build"
  },
  "app": {
    "windows": [
      {
        "title": "Hashi",
        "width": 480,
        "height": 860,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "'self' https://hashi.rs ipc: https://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["https"],
          "host": "hashi.rs",
          "appLink": true,
          "path": [
            "/", "/de", "/fr", "/it", "/es", "/pt", "/nl", "/pl", "/tr", "/ru", "/uk", "/ar", "/hi",
            "/id", "/vi", "/th", "/ja", "/ko", "/zh", "/zh-Hant", "/practice", "/de/practice",
            "/fr/practice", "/it/practice", "/es/practice", "/pt/practice", "/nl/practice",
            "/pl/practice", "/tr/practice", "/ru/practice", "/uk/practice", "/ar/practice",
            "/hi/practice", "/id/practice", "/vi/practice", "/th/practice", "/ja/practice",
            "/ko/practice", "/zh/practice", "/zh-Hant/practice", "/groups", "/de/groups",
            "/fr/groups", "/it/groups", "/es/groups", "/pt/groups", "/nl/groups", "/pl/groups",
            "/tr/groups", "/ru/groups", "/uk/groups", "/ar/groups", "/hi/groups", "/id/groups",
            "/vi/groups", "/th/groups", "/ja/groups", "/ko/groups", "/zh/groups", "/zh-Hant/groups"
          ],
          "pathPrefix": [
            "/g/", "/de/g/", "/fr/g/", "/it/g/", "/es/g/", "/pt/g/", "/nl/g/", "/pl/g/", "/tr/g/",
            "/ru/g/", "/uk/g/", "/ar/g/", "/hi/g/", "/id/g/", "/vi/g/", "/th/g/", "/ja/g/", "/ko/g/",
            "/zh/g/", "/zh-Hant/g/", "/groups/", "/de/groups/", "/fr/groups/", "/it/groups/",
            "/es/groups/", "/pt/groups/", "/nl/groups/", "/pl/groups/", "/tr/groups/", "/ru/groups/",
            "/uk/groups/", "/ar/groups/", "/hi/groups/", "/id/groups/", "/vi/groups/", "/th/groups/",
            "/ja/groups/", "/ko/groups/", "/zh/groups/", "/zh-Hant/groups/", "/player/",
            "/de/player/", "/fr/player/", "/it/player/", "/es/player/", "/pt/player/", "/nl/player/",
            "/pl/player/", "/tr/player/", "/ru/player/", "/uk/player/", "/ar/player/", "/hi/player/",
            "/id/player/", "/vi/player/", "/th/player/", "/ja/player/", "/ko/player/", "/zh/player/",
            "/zh-Hant/player/"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24,
      "debugApplicationIdSuffix": ".debug"
    },
    "iOS": {
      "minimumSystemVersion": "16.4"
    }
  }
}
