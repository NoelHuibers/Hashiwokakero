{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hashi",
  "version": "0.1.0",
  "identifier": "rs.hashi",
  "build": {
    "frontendDist": "../../target/app-dist",
    "devUrl": "http://127.0.0.1:8080",
    "beforeDevCommand": "pnpm run app:web",
    "beforeBuildCommand": "pnpm run app:build"
  },
  "app": {
    "windows": [
      {
        "title": "Hashi",
        "width": 480,
        "height": 860,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self'",
        "font-src": "'self'",
        "connect-src": "'self' https://hashi.rs ipc: https://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
