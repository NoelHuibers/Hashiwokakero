<?xml version="1.0" encoding="utf-8"?>
<!-- Android's backups and transfers to a new phone (Android 12 and newer) without the phone's
     notification secret (Notifications.kt): a copy on another phone would ask as this one -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="hashi.notifications.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="hashi.notifications.xml" />
    </device-transfer>
</data-extraction-rules>
